# deploy/.env on the server (never committed). Generate secrets with: openssl rand -hex 24
SITE_DOMAIN=staging.example.com
API_DOMAIN=api.staging.example.com

POSTGRES_PASSWORD=
# Nakama's server key (--socket.server_key), which clients send: built into the site and the game (CI's
# NAKAMA_CLIENT_KEY secret, the same value), so it isn't secret, but it mustn't be Nakama's default.
NAKAMA_CLIENT_KEY=
# The game server takes sessions signed with NAKAMA_ENCRYPTION_KEY. Refresh tokens (30 days) carry the same
# claims, so the two keys must differ, or a refresh token would pass for a session: deploy.sh won't roll otherwise.
NAKAMA_ENCRYPTION_KEY=
NAKAMA_REFRESH_ENCRYPTION_KEY=
NAKAMA_CONSOLE_USER=
NAKAMA_CONSOLE_PASSWORD=
NAKAMA_CONSOLE_SIGNING_KEY=
# Calls any RPC without a session: stays on the server (Caddy's /api/stats route uses it)
NAKAMA_HTTP_KEY=
