# Copy to .env for local runs; CI sets these for each environment. All are
# read at build time (PUBLIC_* ends up in the browser bundle), except the
# last three, which only the dev server uses.

# The public origin: canonical links, sitemap, social cards.
SITE_URL=http://localhost:8000

# Where browsers reach Nakama (the game at /play uses the same server).
# Locally: the Podman stack in nakama/. On a server: its TLS subdomain, port 443, SSL true.
PUBLIC_NAKAMA_HOST=127.0.0.1
PUBLIC_NAKAMA_PORT=7350
PUBLIC_NAKAMA_SSL=false
PUBLIC_NAKAMA_KEY=defaultkey

# Dev server only (never PUBLIC_: the HTTP key calls any RPC without a session):
# where `npm run dev` sends /api/stats. On a server Caddy does it (deploy/Caddyfile).
NAKAMA_URL=http://127.0.0.1:7350
NAKAMA_HTTP_KEY=defaulthttpkey
# where `npm run dev` sends /match (online matches at /play): the game server (game/, npm run server)
GAME_SERVER_URL=ws://127.0.0.1:7360
