---
import { AccountPanel } from '@/islands/account/AccountPanel'
import Site from '@/layouts/Site.astro'
---

<Site title="Your account" description="Your Scrapyard profile, password and sign-in." path="/account" index={false}>
  <div class="mx-auto w-full max-w-2xl px-4 py-16 sm:py-20">
    <h1 class="font-display text-4xl font-semibold">Your account</h1>
    <AccountPanel client:load />
  </div>
</Site>
