---
import { getEntry, render } from 'astro:content'
import Breadcrumbs from '@/components/guide/Breadcrumbs.astro'
import GuideNav from '@/components/guide/GuideNav.astro'
import GuidePager from '@/components/guide/GuidePager.astro'
import Table from '@/components/guide/Table.astro'
import Site from '@/layouts/Site.astro'
import { GUIDE, type GuidePage } from '@/lib/guide'

// One route for the whole guide: /docs is index.mdx, /docs/<id> the rest.
// Only pages on the GUIDE list are built, so the routes, the sidebar and the
// sitemap always agree.
export function getStaticPaths() {
  return GUIDE.map((page) => ({ params: { slug: page.id === 'index' ? undefined : page.id }, props: { page } }))
}

interface Props {
  page: GuidePage
}

const { page } = Astro.props
const entry = await getEntry('guide', page.id)
if (!entry) throw new Error(`guide: ${page.href} has no src/content/guide/${page.id}.mdx`)
const { Content } = await render(entry)
---

<Site title={entry.data.title} description={entry.data.description} path={page.href}>
  <Breadcrumbs page={page} />
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-[12rem_minmax(0,1fr)] lg:gap-16 lg:py-16">
    <GuideNav current={page.href} />
    <article class="max-w-3xl">
      <div class="guide"><Content components={{ table: Table }} /></div>
      <GuidePager current={page.href} />
    </article>
  </div>
</Site>
