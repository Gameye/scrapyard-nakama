---
interface Props {
  data: Record<string, unknown> // a schema.org object or @graph, without @context
}

// Structured data for search engines, as a JSON-LD script. '<' is escaped, so
// no string in it can close the script tag early.
const json = JSON.stringify({ '@context': 'https://schema.org', ...Astro.props.data }).replace(/</g, '\\u003c')
---

<script type="application/ld+json" set:html={json} />
