# Copy to .env.local for local runs; CI sets these for each environment.
# Read at build time into the bundle. Same server as www's PUBLIC_NAKAMA_*.
VITE_NAKAMA_HOST=127.0.0.1
VITE_NAKAMA_PORT=7350
VITE_NAKAMA_SSL=false
VITE_NAKAMA_KEY=defaultkey

# The game server for online matches (game/server). Unset: in development
# ws://<the page's host>:7360/match, in a build /match on the page's own
# origin (the site's Caddy passes it on). Set it only to point somewhere else.
# VITE_GAME_SERVER=ws://127.0.0.1:7360/match
