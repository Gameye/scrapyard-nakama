# Copy to .env.gameye (gitignored) for scripts/gameye-up.sh. Only the token
# is required; everything else has the default shown.

# Your Gameye API token. Scopes: application:read, application:write and
# regions:read (the script sets up your application and its tag), and
# session:start, session:read, session:stop (Nakama starts a session a match).
GAMEYE_API_TOKEN=

# Gameye's self-serve API (sandbox). Production: https://api.production-gameye.gameye.net
# GAMEYE_API_URL=https://api.sandbox-gameye.gameye.net

# Your Gameye application: created if it doesn't exist, updated if it does
# (bridge networking, port 7360/tcp, 0.5 CPU and 512 MiB, two tags kept,
# no warm pool: a seat token needs a fresh session per match).
# GAMEYE_APPLICATION=scrapyard-nakama
# GAMEYE_REGION=eu-central-1
# GAMEYE_NODE_POOL=trial  # self-serve accounts use the trial pool

# The game server image Gameye pulls, and its tag. Defaults: the image this
# repository publishes (.github/workflows/release.yml), at the tag of the
# commit you have checked out, so the page built here has the same build id.
# GAMEYE_GAME_REGISTRY=ghcr
# GAMEYE_GAME_IMAGE=ghcr.io/gameye/scrapyard-nakama
# GAMEYE_GAME_TAG=sha-<git rev-parse HEAD>
#
# Gameye's GHCR integration currently refuses an image whose GitHub owner
# isn't your Gameye organization's name (409 "GHCR repository owner does not
# match the application organization"; a fix is pending). Until then use
# Docker Hub: your own public repository, which --push-game-image builds and
# pushes to (docker login first):
# GAMEYE_GAME_REGISTRY=dockerhub
# GAMEYE_GAME_IMAGE=<your Docker Hub user>/scrapyard-nakama

# Shared by the Nakama plugin and the relay (at least 32 bytes). Generated
# and written here on the first run if unset.
# RELAY_SECRET=

# The Nakama image. Unset: built here from nakama/Dockerfile. compose.gameye.yml
# runs it on Nakama's default keys (SCRAPYARD_DEV_DEFAULT_KEYS=1, this machine
# only); anywhere else the image refuses to start without its own
# NAKAMA_ENCRYPTION_KEY and NAKAMA_REFRESH_ENCRYPTION_KEY (GAMEYE.md). Or a published
# one, e.g. ghcr.io/gameye/scrapyard-nakama-backend:sha-<commit>.
# NAKAMA_IMAGE=
# The Fleet Manager checkout the local build needs until nakama-fleetmanager
# v0.1.0 is published (nakama/modules-src/go.mod).
# FLEETMANAGER_DIR=../nakama-fleetmanager

# Local ports: the page (open http://localhost:<PAGE_PORT>) and the relay.
# PAGE_PORT=4173
# RELAY_PORT=8790

# docker or podman (default: docker if installed)
# CONTAINER=docker
